---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profileImg from '../assets/profileimg.png';
import WaterButton from '../components/WaterButton.astro';
---

<Layout title="Anastasia — Software Engineering Portfolio">

  <div class="landing">
    <div class="hero">
      <h1 class="i18n" data-en="Hi, I'm Anastasia" data-el="Γεια, είμαι η Αναστασία">Hi, I'm Anastasia</h1>
      <p class="tagline i18n" data-en="Software engineering student &middot; building things with Python and beyond" data-el="Φοιτήτρια Πληροφορικής &middot; φτιάχνω πράγματα με Python και όχι μόνο">Software engineering student &middot; building things with Python and beyond</p>
      <div class="cta-row">
        <WaterButton href="#projects" dataEn="View projects" dataEl="Δες τα έργα" />
      </div>
    </div>

    <div class="now-widget">
      <div class="now-dot"></div>
      <div>
        <span class="label i18n" data-en="Now working on" data-el="Τώρα δουλεύω πάνω στο">Now working on</span>
        <span class="value">My Portfolio website :]</span>
      </div>
    </div>
  </div>





  <section id="about">
    <h2 class="i18n" data-en="About me" data-el="Σχετικά με εμένα">About me</h2>
    <div class="about-wrap">
      <Image src={profileImg} alt="Anastasia" class="about-avatar" width={260} height={260} />
      <div>
        <p class="i18n" data-en="Back in 2021, I started programming with Python, first as a hobby and then more seriously. From small scripts to bigger projects, programming became something I grew to love and now actively study at university." data-el="Το 2021, ξεκίνησα τον προγραμματισμό με Python, πρώτα σαν χόμπι και έπειτα πιο σοβαρά. Από μικρά scripts μέχρι μεγαλύτερα έργα, ο προγραμματισμός εξελίχθηκε σε κάτι που αγαπώ και σπουδάζω στο πανεπιστήμιο.">Back in 2021, I started programming with Python, first as a hobby and then more seriously. From small scripts to bigger projects, programming became something I grew to love and now actively study at university.</p>
        <p class="i18n" data-en="I'm especially interested in Python and I'm always looking for the next thing to build. This site is my little corner of the internet to show it off." data-el="Ενδιαφέρομαι ιδιαίτερα με την Python και ψάχνω πάντα να δημιουργήσω το επόμενο μου project. Αυτή η σελίδα αποτελεί την δική μου γωνιά στο internet για να τα δείξω.">I'm especially interested in Python and I'm always looking for the next thing to build. This site is my little corner of the internet to show it off.</p>
      </div>
    </div>
  </section>

  <section id="skills">
    <h2 class="i18n" data-en="Skills" data-el="Δεξιότητες">Skills</h2>
    <div class="skills-grid">
      <div class="skill-card featured">
        <h3 class="i18n" data-en="Python &amp; data analysis" data-el="Python &amp; ανάλυση δεδομένων">Python &amp; data analysis</h3>
        <p class="sub i18n" data-en="My strongest and longest-running skill" data-el="Η πιο δυνατή και μακροχρόνια μου δεξιότητα">My strongest and longest-running skill</p>
        <div class="skill-list">
          <span class="skill-pill">python</span>
          <span class="skill-pill">pandas</span>
          <span class="skill-pill">numpy</span>
          <span class="skill-pill">CSV/JSON parsing</span>
        </div>
      </div>
      <div class="skill-card">
        <h3 class="i18n" data-en="Languages" data-el="Γλώσσες">Languages</h3>
        <p class="sub i18n" data-en="Comfortable writing and reading" data-el="Άνετα σε γραφή και ανάγνωση">Comfortable writing and reading</p>
        <div class="skill-list">
          <span class="skill-pill">python</span>
          <span class="skill-pill">html/css</span>
        </div>
      </div>
      <div class="skill-card">
        <h3 class="i18n" data-en="Frameworks &amp; tools" data-el="Frameworks &amp; εργαλεία">Frameworks &amp; tools</h3>
        <p class="sub i18n" data-en="What I build with" data-el="Τι χρησιμοποιώ για να φτιάχνω">What I build with</p>
        <div class="skill-list">
          <span class="skill-pill">astro</span>
          <span class="skill-pill">git</span>
          <span class="skill-pill">command line</span>
        </div>
      </div>
      <div class="skill-card">
        <h3 class="i18n" data-en="Currently learning" data-el="Μαθαίνω αυτή την περίοδο">Currently learning</h3>
        <p class="sub i18n" data-en="Actively growing here" data-el="Ενεργά σε εξέλιξη">Actively growing here</p>
        <div class="skill-list">
          <span class="skill-pill">typescript</span>
          <span class="skill-pill">sql</span>
        </div>
      </div>
    </div>
  </section>

  <section id="projects">
    <h2 class="i18n" data-en="Featured projects" data-el="Επιλεγμένα έργα">Featured projects</h2>
    <div class="grid">
      <div class="card case-study">
        <img class="case-shot" src="/universifight.gif" alt="Universifight gameplay preview" loading="lazy" />
        <div>
          <h3>Project one — Universifight</h3>
          <p class="challenge i18n" data-en="Challenge: continuity between game scenes and implementing visual arts frame by frame to the code" data-el="Πρόκληση: η συνοχή μεταξύ των σκηνών του παιχνιδιού και προσαρμογή των frame by frame τεχνών στον κώδικα">Challenge: continuity between game scenes and implementing visual arts frame by frame to the code</p>
          <p class="i18n" data-en="Universifight is a 2D turn-based combat game built with Python and Pygame. Originally made for a university project, it features its own small story, hand-drawn character animations and a full scene pipeline." data-el="Το Universifight είναι ένα 2D παιχνίδι μάχης βασισμένο σε γύρους, φτιαγμένο με Python και Pygame. Δημιουργημένο ως πανεπιστημιακή εργασία, διαθέτει τη δική του μικρή ιστορία, χειροποίητα κινούμενα σχέδια και ένα πλήρες σύστημα σκηνών.">Universifight is a 2D turn-based combat game built with Python and Pygame. Originally made for a university project, it features its own small story, hand-drawn character animations and a full scene pipeline.</p>
          <div class="tags">
            <span class="tag">python</span>
            <span class="tag">pygame-widgets</span>
            <span class="tag">2D game</span>
          </div>
          <div class="card-links">
            <a href="https://github.com/Gemmiee/Universifight/releases" target="_blank" rel="noopener noreferrer" class="i18n" data-en="Live demo" data-el="Ζωντανή προεπισκόπηση">Live demo</a>
            <a href="https://github.com/Gemmiee/Universifight" target="_blank" rel="noopener noreferrer" class="i18n" data-en="Source code" data-el="Πηγαίος κώδικας">Source code</a>
          </div>
        </div>
      </div>
      <div class="card">
        <h3>Project two — AI image generator with UI</h3>
        <p class="i18n" data-en="An AI-powered image generator focused on houses, with user prompt and a friendly interface." data-el="Πρόγραμμα δημιουργίας εικόνων με AI, βασισμένο και φιλικό προς τον χρήστη.">An AI-powered image generator focused on houses, with user prompt and a friendly interface.</p>
        <div class="tags">
          <span class="tag">python</span>
          <span class="tag">tkinter</span>
        </div>
        <div class="card-links">
          <a href="https://github.com/Gemmiee/AI-Image-Generator-with-UI" target="_blank" rel="noopener noreferrer" class="i18n" data-en="Source code" data-el="Πηγαίος κώδικας">Source code</a>
        </div>
      </div>
      <div class="card">
        <h3>Project three — Online user behavior analyzer</h3>
        <p class="i18n" data-en="A group project analyzing online user behavior using Python and data visualization tools." data-el="Ένα ομαδικό έργο που αναλύει τη συμπεριφορά των χρηστών στο διαδίκτυο χρησιμοποιώντας Python και εργαλεία εμφάνισης δεδομένων.">A group project analyzing online user behavior using Python and data visualization tools.</p>
        <div class="tags">
          <span class="tag">python</span>
          <span class="tag">pandas</span>
          <span class="tag">csv</span>
        </div>
        <div class="card-links">
          <a href="https://github.com/thanossavvopoulos/User_Online_Behavior_Analysis" target="_blank" rel="noopener noreferrer" class="i18n" data-en="Source code" data-el="Πηγαίος κώδικας">Source code</a>
        </div>
      </div>
      <div class="card">
        <h3>Project four — Custom image classifier UI</h3>
        <p class="i18n" data-en="A desktop app for training and deploying custom image classifiers, using a ResNet-18 backbone as a frozen feature extractor for fast CPU training, with live training progress and batch classification." data-el="Μια desktop εφαρμογή για εκπαίδευση και ανάπτυξη προσαρμοσμένων ταξινομητών εικόνων, με ResNet-18 ως frozen feature extractor για γρήγορη εκπαίδευση σε CPU, με ζωντανή παρακολούθηση εκπαίδευσης και ταξινόμηση σε παρτίδες.">A desktop app for training and deploying custom image classifiers, using a ResNet-18 backbone as a frozen feature extractor for fast CPU training, with live training progress and batch classification.</p>
        <div class="tags">
          <span class="tag">python</span>
          <span class="tag">pytorch</span>
          <span class="tag">resnet-18</span>
        </div>
        <div class="card-links">
          <a href="https://github.com/Gemmiee/custom_class_image_classification_UI" target="_blank" rel="noopener noreferrer" class="i18n" data-en="Source code" data-el="Πηγαίος κώδικας">Source code</a>
        </div>
      </div>
    </div>
  </section>

  <section id="education">
    <h2 class="i18n" data-en="Education" data-el="Εκπαίδευση">Education</h2>
    <div class="timeline">
      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <h3>BSc. in Computer Science</h3>
        <p class="meta i18n" data-en="Ionian University of Greece" data-el="Ιόνιο Πανεπιστήμιο Ελλάδος">Ionian University of Greece</p>
        <p class="desc i18n" data-en="Expected graduation: 2028" data-el="Αναμενόμενη αποφοίτηση: 2028">Expected graduation: 2028</p>
      </div>
      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <h3 class="i18n" data-en="Python online courses" data-el="Διαδικτυακά μαθήματα Python">Python online courses</h3>
        <p class="meta i18n" data-en="IT EXPERTS Athens" data-el="IT EXPERTS Athens">IT EXPERTS Athens</p>
        <p class="desc i18n" data-en="2021 - present" data-el="2021 - σήμερα">2021 - present</p>
        <p class="desc i18n" data-en="Dedicated python courses on AI, PyGame, PyAutoGUI, Tkinter, Data Analysis" data-el="Μαθήματα Python σε AI, PyGame, PyAutoGUI, Tkinter, Data Analysis">Dedicated python courses on AI, PyGame, PyAutoGUI, Tkinter, Data Analysis</p>
      </div>
    </div>
  </section>

  <section id="github">
    <h2 class="i18n" data-en="My code" data-el="Ο κώδικάς μου">My code</h2>
    <div class="github-widget">
      <div class="gh-text">
        <h3 class="i18n" data-en="Check out my GitHub" data-el="Δες το GitHub μου">Check out my GitHub</h3>
        <p class="i18n" data-en="Pinned repos, contribution activity, and everything I'm building in the open." data-el="Pinned repos, δραστηριότητα και ό,τι φτιάχνω δημόσια.">Pinned repos, contribution activity, and everything I'm building in the open.</p>
      </div>
      <a class="btn-glossy secondary i18n" data-en="View profile" data-el="Δες το προφίλ" href="https://github.com/Gemmiee" target="_blank" rel="noopener noreferrer">View profile</a>
    </div>
  </section>

  <section id="contact">
    <h2 class="i18n" data-en="Get in touch" data-el="Επικοινωνήστε μαζί μου">Get in touch</h2>
    <div class="contact-row">
      <a class="contact-pill" href="mailto:gemmie.dares407@passinbox.com">Email</a>
      <a class="contact-pill" href="https://github.com/Gemmiee" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </section>

</Layout>

<style>
  @media (max-width: 640px) {
    .landing {
      min-height: calc(100svh - 60px);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  .hero {
    text-align: center;
    padding: 90px 20px 70px;
  }
  .hero h1 {
    font-size: 46px;
    font-weight: 700;
    margin: 0 0 8px;
    background: linear-gradient(to bottom, #134f76, #3979a1);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.5);
  }
  .hero p.tagline {
    font-size: 18px;
    color: var(--ink);
    opacity: 0.8;
    margin: 0 0 30px;
  }
  .cta-row {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  section {
    padding: 50px 40px;
    max-width: 960px;
    margin: 0 auto;
  }
  section h2 {
    font-size: 26px;
    color: var(--blue-deep);
    text-align: center;
    margin-bottom: 30px;
  }

  .now-widget {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 460px;
    margin: 0 auto 10px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.5));
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 999px;
    padding: 10px 22px;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.8), 0 3px 10px rgba(28, 110, 164, 0.15);
  }
  .now-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, #7CE0A0, var(--green));
    box-shadow: 0 0 6px rgba(46, 158, 91, 0.7);
    flex-shrink: 0;
  }
  .now-widget span.label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--blue-deep);
    opacity: 0.6;
    display: block;
  }
  .now-widget span.value {
    font-size: 14px;
    font-weight: 500;
    color: var(--blue-deep);
  }

  .about-wrap {
    display: flex;
    align-items: center;
    gap: 36px;
    background: var(--glass);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 4px 16px rgba(28, 110, 164, 0.12), inset 0 1px 1px rgba(255, 255, 255, 0.7);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .about-wrap:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(28, 110, 164, 0.22), inset 0 1px 1px rgba(255, 255, 255, 0.7);
  }
  .about-avatar {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    object-fit: cover;
    background: linear-gradient(to bottom, #BEE3FA, #4FA8E0 45%, #1C6EA4);
    flex-shrink: 0;
    box-shadow: inset 0 2px 4px rgba(255, 255, 255, 0.6), 0 3px 10px rgba(0, 0, 0, 0.15);
  }
  .about-wrap p {
    font-size: 16px;
    line-height: 1.7;
    margin: 0;
  }
  .about-wrap p + p {
    margin-top: 10px;
  }

  @media (max-width: 600px) {
    .about-wrap {
      flex-direction: column;
      text-align: center;
      gap: 20px;
      padding: 24px;
    }
  }

  

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }
  .skill-card {
    background: var(--glass);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 3px 12px rgba(28, 110, 164, 0.12), inset 0 1px 1px rgba(255, 255, 255, 0.7);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .skill-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 9px 20px rgba(28, 110, 164, 0.22), inset 0 1px 1px rgba(255, 255, 255, 0.7);
  }
  .skill-card.featured {
    background: linear-gradient(160deg, rgba(255, 197, 138, 0.35), rgba(255, 255, 255, 0.6));
    border: 1px solid rgba(255, 158, 66, 0.4);
    box-shadow: 0 4px 16px rgba(255, 140, 66, 0.2), inset 0 1px 1px rgba(255, 255, 255, 0.7);
  }
  .skill-card.featured:hover {
    box-shadow: 0 10px 24px rgba(255, 140, 66, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.7);
  }
  .skill-card h3 {
    margin: 0 0 4px;
    font-size: 15px;
    color: var(--blue-deep);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .skill-card.featured h3 {
    color: var(--orange-dark);
  }
  .skill-card .sub {
    font-size: 12px;
    color: var(--ink);
    opacity: 0.65;
    margin: 0 0 12px;
  }
  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .skill-card.featured .skill-pill {
    background: linear-gradient(to bottom, #FFE0BC, #FFC58A);
    color: #7a3b12;
    border: 1px solid rgba(224, 109, 34, 0.25);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }
  .card h3 {
    margin: 0 0 8px;
    color: var(--blue-deep);
    font-size: 18px;
  }
  .card p {
    font-size: 16px;
    line-height: 1.5;
    margin: 0 0 14px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
  }
  .card-links {
    display: flex;
    gap: 10px;
  }
  .card-links a {
    font-size: 13px;
    color: var(--orange-dark);
    font-weight: 500;
    text-decoration: none;
  }
  .card-links a:hover {
    text-decoration: underline;
  }

  .case-study {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
    align-items: center;
  }
  .case-shot {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    object-fit: cover;
    background: linear-gradient(135deg, var(--blue-light), var(--blue-mid));
    box-shadow: inset 0 2px 4px rgba(255, 255, 255, 0.5);
  }
  .case-study .challenge {
    font-size: 15px;
    color: var(--orange-dark);
    font-weight: 500;
    margin: 0 0 10px;
  }
  @media (max-width: 600px) {
    .case-study {
      grid-template-columns: 1fr;
    }
  }

  .timeline {
    position: relative;
    padding-left: 26px;
  }
  .timeline::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 4px;
    bottom: 4px;
    width: 2px;
    background: linear-gradient(to bottom, var(--blue-mid), var(--orange));
  }
  .timeline-item {
    position: relative;
    margin-bottom: 26px;
  }
  .timeline-item:last-child {
    margin-bottom: 0;
  }
  .timeline-dot {
    position: absolute;
    left: -26px;
    top: 4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, #BEE3FA, var(--blue-deep));
    box-shadow: 0 0 0 3px var(--bg);
  }
  .timeline-item h3 {
    margin: 0 0 2px;
    font-size: 16px;
    color: var(--blue-deep);
  }
  .timeline-item .meta {
    font-size: 12px;
    opacity: 0.6;
    margin: 0 0 4px;
  }
  .timeline-item p.desc {
    font-size: 16px;
    margin: 0;
    line-height: 1.5;
  }

  .github-widget {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    background: var(--glass);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 18px;
    padding: 24px;
    box-shadow: 0 4px 16px rgba(28, 110, 164, 0.12), inset 0 1px 1px rgba(255, 255, 255, 0.7);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .github-widget:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(28, 110, 164, 0.22), inset 0 1px 1px rgba(255, 255, 255, 0.7);
  }
  .github-widget .gh-text h3 {
    margin: 0 0 4px;
    color: var(--blue-deep);
    font-size: 17px;
  }
  .github-widget .gh-text p {
    margin: 0;
    font-size: 15px;
    opacity: 0.7;
  }

  .contact-row {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* Desktop only — bigger type/spacing so content fills the screen more;
     mobile styles above are untouched. */
  @media (min-width: 641px) {
    .hero h1 {
      font-size: 58px;
    }
    .hero p.tagline {
      font-size: 21px;
    }

    section {
      max-width: 1100px;
      padding: 60px 50px;
    }
    section h2 {
      font-size: 32px;
    }

    .now-widget {
      max-width: 500px;
    }
    .now-widget span.value {
      font-size: 15px;
    }

    .about-wrap {
      gap: 44px;
      padding: 38px;
    }
    .about-avatar {
      width: 130px;
      height: 130px;
    }
    .about-wrap p {
      font-size: 17px;
    }

    .skill-card {
      padding: 26px;
    }
    .skill-card h3 {
      font-size: 17px;
    }
    .skill-card .sub {
      font-size: 13px;
    }

    .card h3 {
      font-size: 21px;
    }
    .card p {
      font-size: 17px;
    }
    .card-links a {
      font-size: 14px;
    }
    .case-study {
      grid-template-columns: 260px 1fr;
    }
    .case-study .challenge {
      font-size: 16px;
    }

    .timeline-item h3 {
      font-size: 18px;
    }
    .timeline-item .meta {
      font-size: 13px;
    }
    .timeline-item p.desc {
      font-size: 17px;
    }

    .github-widget {
      padding: 30px;
    }
